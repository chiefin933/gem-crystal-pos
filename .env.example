# Gem & Crystal POS Terminal — Environment

# ── API Backend ────────────────────────────────────────────────────────────
# Development: leave empty — Vite proxies /api → localhost:4000 automatically
# Production: set to your deployed API URL e.g. https://api.gemandcrystal.co.ke
VITE_API_URL=

# ── Demo Fallback ─────────────────────────────────────────────────────────
# Set to "true" ONLY in development to load demo products if API is unavailable.
# NEVER set this in production.
VITE_ENABLE_DEMO_FALLBACK=true
